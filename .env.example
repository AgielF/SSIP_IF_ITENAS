




# =========================================================================
# 1. ENVIRONMENT (Pilih: development, testing, atau production)
# =========================================================================
CI_ENVIRONMENT = production

# =========================================================================
# 2. PENGATURAN APLIKASI UTAMA (Otomatis masuk ke Config/App.php)
# =========================================================================
# URL Aplikasi (Ubah ke https://domain-anda.com/ jika di hosting)
app.baseURL = 'http://localhost:8080/'

# Paksa HTTPS? (Ubah ke true jika di hPanel, false jika di localhost)
app.forceGlobalSecureRequests = false

# =========================================================================
# 3. DATABASE (PENGATURAN PRODUKSI/HOSTING)
# =========================================================================
database.default.hostname = localhost
# Isi dengan data hPanel saat deploy (contoh: u123456789_ssip)
database.default.database = ssip
# Isi dengan data hPanel saat deploy (contoh: u123456789_admin)
database.default.username = root
# Isi dengan password database hPanel saat deploy
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

# =========================================================================
# 4. DATABASE KHUSUS TESTING (Untuk XSStrike / PHPUnit)
# =========================================================================
database.tests.hostname = 
database.tests.database = 
database.tests.username = 
database.tests.password = 
database.tests.DBDriver = 
database.tests.port = 



# Hilangkan index.php pada URL saat di Hosting
app.indexPage = ''



# =========================================================================
# 5. KUNCI RAHASIA (SECRET KEYS)
# =========================================================================
JWT_SECRET="ce9aae5326cc9b62a7f54e574fc0252dfe81ff8ba769d75ebe8beb348d287496"