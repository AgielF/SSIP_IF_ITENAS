#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# Gunakan 'development' untuk lokal, 'production' untuk server asli
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE DEFAULT (APLIKASI UTAMA)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = nama_db_utama
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# DATABASE TESTING (KHUSUS PHPUNIT)
#--------------------------------------------------------------------
database.tests.hostname = 127.0.0.1
database.tests.database = nama_db_testing
database.tests.username = root
database.tests.password = 
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = 
database.tests.port = 3306

#--------------------------------------------------------------------
# SECURITY (JWT)
#--------------------------------------------------------------------
# Generate secret key 64 karakter untuk keamanan maksimal
JWT_SECRET="isi_dengan_secret_key_anda_disini"

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# logger.threshold = 4